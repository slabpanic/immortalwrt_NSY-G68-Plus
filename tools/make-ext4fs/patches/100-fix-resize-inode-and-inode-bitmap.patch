Subject: [PATCH] Create consistent inode bitmaps and a growable resize inode

Mark unused inode bitmap bits as allocated so e2fsck accepts a freshly
created filesystem. Match e2fsprogs' resize inode layout: primary reserved
GDT pointers start at the descriptor-block offset, and the logical size
covers the full double-indirect range. The old rotated pointer array
causes the kernel to reject online growth when adding backup groups.

--- a/allocate.c
+++ b/allocate.c
@@ -293,6 +293,10 @@
 	bg->block_bitmap = bg->bitmaps;
 	bg->inode_bitmap = bg->bitmaps + info.block_size;
 
+	/* Inodes beyond this group's inode table must never appear free. */
+	for (u32 inode = info.inodes_per_group; inode < info.block_size * 8; inode++)
+		bitmap_set_bit(bg->inode_bitmap, inode);
+
 	bg->header_blocks = header_blocks;
 	bg->first_block = aux_info.first_data_block + i * info.blocks_per_group;
 
--- a/indirect.c
+++ b/indirect.c
@@ -455,24 +455,19 @@
 			get_block(alloc, 0));
 
 	for (i = 0; i < info.bg_desc_reserve_blocks; i++) {
-		int r = (i - aux_info.bg_desc_blocks) % info.bg_desc_reserve_blocks;
-		if (r < 0)
-			r += info.bg_desc_reserve_blocks;
-
-		dind_block_data[i] = get_block(alloc, r);
+		u32 index = (aux_info.bg_desc_blocks + i) % aux_info.blocks_per_ind;
+
+		dind_block_data[index] = get_block(alloc, i);
 
 		for (j = 1; j < superblocks; j++) {
-			u32 b = j * info.bg_desc_reserve_blocks + r;
-			ind_block_data[r * aux_info.blocks_per_ind + j - 1] = get_block(alloc, b);
-		}
-	}
-
-	u32 last_block = EXT4_NDIR_BLOCKS + aux_info.blocks_per_ind +
-			aux_info.blocks_per_ind * (info.bg_desc_reserve_blocks - 1) +
-			superblocks - 2;
+			u32 b = j * info.bg_desc_reserve_blocks + i;
+			ind_block_data[i * aux_info.blocks_per_ind + j - 1] = get_block(alloc, b);
+		}
+	}
 
 	blocks = ((u64)block_len + 1) * info.block_size / 512;
-	size = (u64)last_block * info.block_size;
+	size = ((u64)aux_info.blocks_per_ind * aux_info.blocks_per_ind +
+		aux_info.blocks_per_ind + EXT4_NDIR_BLOCKS) * info.block_size;
 
 	inode->i_block[EXT4_DIND_BLOCK] = dind_block;
 	inode->i_flags = 0;
